# Copy to .env and adjust. docker compose and scripts/dev.sh both read it.

# Where Ollama is listening. From Docker on Windows or Mac this is the host machine.
OLLAMA_URL=http://host.docker.internal:11434

# Embeddings: ollama (bge-m3, multilingual, recommended) or hash (no model, testing only).
# Changing this later requires `wassup rebuild-stories`.
EMBED_BACKEND=ollama
EMBED_MODEL=bge-m3

# Triage: rules, hybrid (rules first, local LLM when unsure), or ollama (local LLM for everything).
TRIAGE_BACKEND=hybrid
TRIAGE_MODEL=qwen3:8b

# Free key from https://api.congress.gov/sign-up/ (the shared DEMO_KEY is often rate limited).
CONGRESS_API_KEY=

# How many 15 minute GDELT files to backfill on first start (16 = 4 hours).
GDELT_BACKFILL_FILES=16

# Only used when running outside Docker (scripts/dev.sh).
DATABASE_URL=postgresql://wassup:wassup@localhost:5432/wassup
