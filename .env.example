# Copy to .env and adjust. docker compose and scripts/dev.sh both read it.

# Where Ollama is listening. From Docker on Windows or Mac this is the host machine.
OLLAMA_URL=http://host.docker.internal:11434

# Embeddings: ollama (bge-m3, multilingual, recommended) or hash (no model, testing only).
# Changing this later requires `wassup rebuild-stories`.
EMBED_BACKEND=ollama
EMBED_MODEL=bge-m3

# Triage: rules, hybrid (rules first, local LLM when unsure), or ollama (local LLM for everything).
TRIAGE_BACKEND=hybrid
TRIAGE_MODEL=qwen3:8b

# Jev (TypeSafe AI) for fast triage decisions. Leave empty to use rules plus the local model only.
# Jev is asked only about stories the keyword rules are unsure of, and spending stops for the
# day at JEV_DAILY_BUDGET_USD.
TYPESAFE_API_KEY=
JEV_DAILY_BUDGET_USD=0.50

# Translate non English headlines into English: ollama or off. Uses TRIAGE_MODEL unless set.
TRANSLATE_BACKEND=ollama
TRANSLATE_MODEL=

# Free key from https://api.congress.gov/sign-up/ (the shared DEMO_KEY is often rate limited).
CONGRESS_API_KEY=

# How many 15 minute GDELT files to backfill on first start (16 = 4 hours).
GDELT_BACKFILL_FILES=16

# Newsroom (Phase 1, optional). See docs/NEWSROOM.md.
# A random secret for Paperclip's logins. Generate one with: openssl rand -hex 32
BETTER_AUTH_SECRET=
# The Editor in Chief runs on Claude. Use ONE of these:
#   CLAUDE_CODE_OAUTH_TOKEN from `claude setup-token` (uses your Claude subscription), or
#   ANTHROPIC_API_KEY from console.anthropic.com (pay per use).
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=

# Only used when running outside Docker (scripts/dev.sh).
DATABASE_URL=postgresql://wassup:wassup@localhost:5432/wassup
